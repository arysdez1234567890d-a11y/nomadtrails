# Скопируйте этот файл в .env.local и заполните своими значениями.

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXX

# ===== NextAuth v5 =====
# Сгенерируйте секрет: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВАЖНО: AUTH_SECRET должен быть стабильным — иначе все сессии будут постоянно сбрасываться.
AUTH_SECRET=replace-with-32-byte-random-string

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL сайта
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
